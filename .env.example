# ──────────────────────────────────────────────────────────
# BANCO DE DADOS
# ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ──────────────────────────────────────────────────────────
# SERVIDOR
# ──────────────────────────────────────────────────────────
PORT=8080
PORT_SERVER=3003

# ──────────────────────────────────────────────────────────
# SEGURANÇA / JWT
# ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=sua_chave_access_aqui
JWT_ACCESS_EXPIRES_IN=55m
JWT_REFRESH_SECRET=sua_chave_refresh_aqui
JWT_REFRESH_EXPIRES_IN=15d

# ──────────────────────────────────────────────────────────
# EVOLUTION API (WhatsApp)
# ──────────────────────────────────────────────────────────
EVO_API_KEY=sua_chave_evolution
EVO_BASE_URL=http://localhost:8080
INSTANCE_NAME=atendimento-01
WEBHOOK_URL=http://localhost:3003/webhook/message/connection-update
WEBHOOK_ALLOWED_IPS=172.18.0.5

# ──────────────────────────────────────────────────────────
# INFRA (Redis)
# ──────────────────────────────────────────────────────────
API_KEY=sua_chave_secreta_aqui
REDIS_PASSWORD=senha_do_redis
CLIENT_SLUG=meu-cliente
SERVER_URL=http://evolution:8080

# ──────────────────────────────────────────────────────────
# DADOS DA EMPRESA (para o seed)
# ──────────────────────────────────────────────────────────
NUMBER="5551999999999"
BUSINESS_NAME="Minha Empresa"
SPECIALTY="Minha Especialidade"
PHONE_BUSINESS="(51) 99999-9999"
EMAIL="contato@meuemail.com"
ADDRESS="Cidade - Estado"
LOGO_URL="https://placehold.co/600x400"
PROPOSAL_TERMS="Proposta válida conforme condições comerciais apresentadas."
WARRANTY_TERMS="Garantia de 90 dias para correções relacionadas ao serviço entregue."
PROPOSAL_VALIDITY_DAYS=7
DEFAULT_BILLING_UNIT="UNIDADE"
