<html lang='pt-BR'>
  <head>
    <meta charset='UTF-8' />
    <style>
      body {
        font-family: Arial, sans-serif;
        color: #333;
        padding: 40px;
        font-size: 12px;
      }

      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #000;
        padding-bottom: 12px;
        margin-bottom: 25px;
      }

      .left {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .logo-img {
        height: 45px;
        width: auto;
      }

      .company-name {
        font-size: 18px;
        font-weight: bold;
      }

      .right {
        text-align: right;
      }

      .doc-title {
        font-size: 16px;
        font-weight: bold;
      }

      .title {
        text-align: right;
      }

      .section {
        margin-bottom: 20px;
      }

      .section-title {
        font-weight: bold;
        margin-bottom: 8px;
        font-size: 14px;
        border-bottom: 1px solid #ddd;
        padding-bottom: 4px;
      }

      .info-grid {
        display: flex;
        justify-content: space-between;
      }

      .info-grid div {
        width: 48%;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
      }

      table th {
        background: #f5f5f5;
        text-align: left;
        padding: 8px;
        border: 1px solid #ddd;
      }

      table td {
        padding: 8px;
        border: 1px solid #ddd;
      }

      .totals {
        margin-top: 20px;
        width: 300px;
        float: right;
      }

      .totals div {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
      }

      .totals .final {
        font-weight: bold;
        font-size: 14px;
        border-top: 2px solid #000;
        padding-top: 5px;
      }

      .footer {
        position: absolute;
        bottom: 30px;
        left: 40px;
        right: 40px;
        text-align: center;
        font-size: 10px;
        color: #777;
      }
    </style>
  </head>

  <body>

    <!-- HEADER -->
    <div class='header'>
      <div class='left'>
      
        <div class='company-info'>
          <div class='company-name'>{{companyName}}</div>
        </div>
      </div>

      <div class='right'>
        <div class='doc-title'>ORÇAMENTO</div>
        <div><strong>#{{id}}</strong></div>
        <div>Emitido em: {{createdAt}}</div>
      </div>
    </div>

    <!-- CLIENTE -->
    <div class='section'>
      <div class='section-title'>Dados do Cliente</div>
      <div class='info-grid'>
        <div>
          <strong>Nome:</strong>
          {{name}}<br />
          <strong>Telefone:</strong>
          {{phone}}<br />
        </div>
        <div>
          <strong>Endereço:</strong><br />
          {{address}}
        </div>
      </div>
    </div>

    <!-- SERVIÇO -->
    <div class='section'>
      <div class='section-title'>Detalhes do Serviço</div>

      <strong>{{title}}</strong><br />

      <p>{{description}}</p>

      <p>
        <strong>Período do serviço:</strong><br />
        Início:
        {{initDate}}<br />
        Conclusão:
        {{endDate}}
      </p>
    </div>

    <!-- MATERIAIS -->
    <div class='section'>
      <div class='section-title'>Materiais</div>

      <table>
        <thead>
          <tr>
            <th>Item</th>
            <th>Qtd</th>
            <th>Valor Unitário</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {{#each materials}}
            <tr>
              <td>{{this.name}}</td>
              <td>{{this.quantity}}</td>
              <td>{{this.unitValue}}</td>
              <td>{{this.total}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- RESUMO -->
    <div class='totals'>
      <div>
        <span>Mão de obra:</span>
        <span>{{laborValue}}</span>
      </div>
      <div>
        <span>Materiais:</span>
        <span>{{materialValue}}</span>
      </div>
      <div>
        <span>Desconto:</span>
        <span>{{discount}}</span>
      </div>
      <div class='final'>
        <span>Total:</span>
        <span>{{totalValue}}</span>
      </div>
    </div>

    <!-- OBS -->
    <div class='section' style='clear: both;'>
      <div class='section-title'>Observações</div>
      <p>{{observations}}</p>
    </div>

    <!-- VALIDADE -->
    <div class='section'>
      <div class='section-title'>Validade</div>
      <p>
        Este orçamento é válido até
        <strong>{{validityDate}}</strong>.<br />
        Após essa data, os valores poderão sofrer alterações.
      </p>
    </div>

    <!-- FOOTER -->
    <div class='footer'>
      {{companyName}}
      •
      {{companyPhone}}
      •
      {{companyEmail}}
    </div>

  </body>
</html>